# Build output
/target
/tools/*/target

# Generated mobile FFI and binding artifacts (rebuilt by scripts/build/*, copied
# into apps/ by scripts/sync/*)
/dist/

# Every mobile binding and native artifact is generated, not vendored: UniFFI writes
# the Kotlin and Swift sources from the Rust crates, and the libraries are compiled per
# ABI. Build and sync them before opening either application.
#   scripts/build/mobile-controller-bindings.sh --all
#   scripts/sync/mobile-controller-bindings.sh --write
#   scripts/build/mobile-screen-bindings.sh --all
#   scripts/sync/mobile-screen-bindings.sh --write
#   scripts/sync/mobile-ffi-artifacts.sh all
#   scripts/build/mobile-replication-artifacts.py
# The checksum and provenance manifests beside them are written by the same builders, so they
# record the artifacts this machine produced rather than anything to compare a checkout against.
/apps/ios/Frameworks/
/apps/ios/Replication/
/apps/ios/MultiplexMobile/Generated/
/apps/android/app/src/main/java/com/multiplex/screens/
/apps/android/app/src/main/java/com/multiplex/controller/security/
/apps/android/app/src/main/replication/
/apps/android/app/src/main/jniLibs/

# Generated Xcode projects: the applications' own project is written by XcodeGen from
# apps/ios/project.yml, as is the provider-access fixture's.
/apps/ios/*.xcodeproj/
/apps/ios/ProviderAccessFixture/*.xcodeproj/

# Generated leftovers from checkouts before mobile/ moved to apps/.
# Keep these narrow so accidental source edits in the old tree remain visible.
/mobile/android/.gradle/
/mobile/android/app/build/
/mobile/android/build/
/mobile/android/app/src/test/native/
/mobile/ios/ProviderAccessFixture/*.xcodeproj/

# Local tooling state
.claude/settings.local.json
.DS_Store
__pycache__/
*.py[cod]
