# Build output
/target
/tools/*/target

# Generated mobile FFI and binding artifacts (rebuilt by scripts/build/*, copied
# into apps/ by scripts/sync/*)
/dist/

# Remote Screens bindings, generated the same way. Unlike the Controller and vault
# artifacts beside them, these are not vendored: build and sync them before opening
# the applications.
#   scripts/build/mobile-screen-bindings.sh --all
#   scripts/sync/mobile-screen-bindings.sh --write
/apps/ios/Frameworks/TermiRustRemoteScreens.xcframework/
/apps/ios/TermiRustMobile/Generated/TermiRustRemoteScreens.swift
/apps/android/app/src/main/java/com/termirust/screens/
/apps/android/app/src/main/jniLibs/*/libtermirust_screen_bindings.so

# Generated Xcode project for the iOS provider-access fixture
/apps/ios/ProviderAccessFixture/*.xcodeproj/

# Generated leftovers from checkouts before mobile/ moved to apps/.
# Keep these narrow so accidental source edits in the old tree remain visible.
/mobile/android/.gradle/
/mobile/android/app/build/
/mobile/android/build/
/mobile/android/app/src/test/native/
/mobile/ios/ProviderAccessFixture/*.xcodeproj/

# Local tooling state
.claude/settings.local.json
.DS_Store
__pycache__/
*.py[cod]
