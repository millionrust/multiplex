{
  "schema_version": 1,
  "limits": {
    "max_paste_bytes": 262144,
    "paste_confirmation_bytes": 4096,
    "max_url_bytes": 2048,
    "max_urls": 32
  },
  "key_cases": [
    { "name": "escape", "key": "escape", "expected": [27] },
    { "name": "tab", "key": "tab", "expected": [9] },
    { "name": "shift-tab", "key": "tab", "shift": true, "expected": [27, 91, 90] },
    { "name": "enter", "key": "enter", "expected": [13] },
    { "name": "backspace", "key": "backspace", "expected": [127] },
    { "name": "normal-up", "key": "up", "expected": [27, 91, 65] },
    { "name": "application-up", "key": "up", "application_cursor": true, "expected": [27, 79, 65] },
    { "name": "normal-down", "key": "down", "expected": [27, 91, 66] },
    { "name": "application-down", "key": "down", "application_cursor": true, "expected": [27, 79, 66] },
    { "name": "normal-left", "key": "left", "expected": [27, 91, 68] },
    { "name": "application-left", "key": "left", "application_cursor": true, "expected": [27, 79, 68] },
    { "name": "normal-right", "key": "right", "expected": [27, 91, 67] },
    { "name": "application-right", "key": "right", "application_cursor": true, "expected": [27, 79, 67] },
    { "name": "normal-home", "key": "home", "expected": [27, 91, 72] },
    { "name": "application-home", "key": "home", "application_cursor": true, "expected": [27, 79, 72] },
    { "name": "normal-end", "key": "end", "expected": [27, 91, 70] },
    { "name": "application-end", "key": "end", "application_cursor": true, "expected": [27, 79, 70] },
    { "name": "insert", "key": "insert", "expected": [27, 91, 50, 126] },
    { "name": "delete", "key": "delete", "expected": [27, 91, 51, 126] },
    { "name": "page-up", "key": "pageup", "expected": [27, 91, 53, 126] },
    { "name": "page-down", "key": "pagedown", "expected": [27, 91, 54, 126] },
    { "name": "control-a", "key": "a", "text": "a", "control": true, "expected": [1] },
    { "name": "control-left-bracket", "key": "[", "text": "[", "control": true, "expected": [27] },
    { "name": "control-space", "key": "space", "text": " ", "control": true, "expected": [0] },
    { "name": "alt-x", "key": "x", "text": "x", "alt": true, "expected": [27, 120] },
    { "name": "unicode-text", "key": "text", "text": "é界", "expected": [195, 169, 231, 149, 140] },
    { "name": "alt-unicode", "key": "text", "text": "é", "alt": true, "expected": [27, 195, 169] }
  ],
  "paste_cases": [
    { "name": "single-line", "input": "printf ok", "bracketed": false, "requires_confirmation": false, "expected": [112, 114, 105, 110, 116, 102, 32, 111, 107] },
    { "name": "crlf-normalized", "input": "one\r\ntwo", "bracketed": false, "requires_confirmation": true, "expected": [111, 110, 101, 10, 116, 119, 111] },
    { "name": "multiline-bracketed", "input": "one\ntwo", "bracketed": true, "requires_confirmation": true, "expected": [27, 91, 50, 48, 48, 126, 111, 110, 101, 10, 116, 119, 111, 27, 91, 50, 48, 49, 126] },
    { "name": "threshold", "input_repeat": { "value": "x", "count": 4096 }, "bracketed": false, "requires_confirmation": false },
    { "name": "over-threshold", "input_repeat": { "value": "x", "count": 4097 }, "bracketed": false, "requires_confirmation": true }
  ],
  "selection_cases": [
    {
      "name": "plain-range-excludes-padding",
      "rows": [
        [{ "text": "h", "width": 1 }, { "text": "i", "width": 1 }],
        [{ "text": "o", "width": 1 }, { "text": "k", "width": 1 }]
      ],
      "start": { "row": 0, "column": 1 },
      "end": { "row": 1, "column": 2 },
      "expected": "i\nok"
    },
    {
      "name": "wide-continuation-once",
      "rows": [[{ "text": "A", "width": 1 }, { "text": "界", "width": 2 }, { "text": "", "width": 0 }, { "text": "B", "width": 1 }]],
      "start": { "row": 0, "column": 0 },
      "end": { "row": 0, "column": 4 },
      "expected": "A界B"
    },
    {
      "name": "combining-grapheme-kept",
      "rows": [[{ "text": "é", "width": 1 }, { "text": "!", "width": 1 }]],
      "start": { "row": 0, "column": 0 },
      "end": { "row": 0, "column": 1 },
      "expected": "é"
    }
  ],
  "ime_cases": [
    {
      "name": "updates-stay-local-until-commit",
      "operations": [
        { "kind": "update", "text": "に" },
        { "kind": "update", "text": "日本" },
        { "kind": "commit", "text": "日本" }
      ],
      "expected_emissions": [[230, 151, 165, 230, 156, 172]]
    },
    {
      "name": "cancel-sends-nothing",
      "operations": [{ "kind": "update", "text": "é" }, { "kind": "cancel" }],
      "expected_emissions": []
    },
    {
      "name": "direct-commit-once",
      "operations": [{ "kind": "commit", "text": "hello" }],
      "expected_emissions": [[104, 101, 108, 108, 111]]
    },
    {
      "name": "finish-commits-marked-once",
      "operations": [{ "kind": "update", "text": "한" }, { "kind": "finish" }],
      "expected_emissions": [[237, 149, 156]]
    }
  ],
  "url_cases": [
    { "name": "http-and-https", "text": "open https://example.com/a?q=1 or http://localhost:8080/x", "expected": ["https://example.com/a?q=1", "http://localhost:8080/x"] },
    { "name": "trim-punctuation", "text": "See (https://example.com/docs).", "expected": ["https://example.com/docs"] },
    { "name": "reject-other-schemes", "text": "file:///etc/passwd ssh://host javascript:alert(1)", "expected": [] },
    { "name": "osc-is-not-visible", "text": "safe text only", "expected": [] }
  ],
  "mouse_cases_notes": "xterm mouse reports: SGR is ESC [ < Cb ; column ; row and M for press or m for release, where Cb adds 4 for shift, 8 for alt, 16 for control, 32 for a drag, 3 for a legacy release and 64 or 65 for the wheel. Columns and rows are 1-based, and the legacy encodings add 32 to every value.",
  "mouse_cases": [
    {"name": "sgr-press-at-origin", "mode": "press_release", "encoding": "sgr", "kind": "press", "row": 0, "col": 0, "expected": [27, 91, 60, 48, 59, 49, 59, 49, 77]},
    {"name": "sgr-release", "mode": "press_release", "encoding": "sgr", "kind": "release", "row": 4, "col": 9, "expected": [27, 91, 60, 51, 59, 49, 48, 59, 53, 109]},
    {"name": "sgr-press-with-shift", "mode": "press_release", "encoding": "sgr", "kind": "press", "row": 4, "col": 9, "shift": true, "expected": [27, 91, 60, 52, 59, 49, 48, 59, 53, 77]},
    {"name": "sgr-press-with-control-and-alt", "mode": "press_release", "encoding": "sgr", "kind": "press", "row": 4, "col": 9, "control": true, "alt": true, "expected": [27, 91, 60, 50, 52, 59, 49, 48, 59, 53, 77]},
    {"name": "drag-is-reported-in-button-motion", "mode": "button_motion", "encoding": "sgr", "kind": "move", "dragging": true, "row": 4, "col": 9, "expected": [27, 91, 60, 51, 50, 59, 49, 48, 59, 53, 77]},
    {"name": "hover-is-not-reported-in-button-motion", "mode": "button_motion", "encoding": "sgr", "kind": "move", "dragging": false, "row": 4, "col": 9, "expected": null},
    {"name": "hover-is-reported-in-any-motion", "mode": "any_motion", "encoding": "sgr", "kind": "move", "dragging": false, "row": 4, "col": 9, "expected": [27, 91, 60, 51, 53, 59, 49, 48, 59, 53, 77]},
    {"name": "press-only-mode-has-no-release", "mode": "press", "encoding": "sgr", "kind": "release", "row": 0, "col": 0, "expected": null},
    {"name": "reporting-off-sends-nothing", "mode": "none", "encoding": "sgr", "kind": "press", "row": 0, "col": 0, "expected": null},
    {"name": "wheel-toward-earlier-output-is-button-64", "mode": "press_release", "encoding": "sgr", "kind": "wheel", "wheel_lines": 1.0, "row": 4, "col": 9, "expected": [27, 91, 60, 54, 52, 59, 49, 48, 59, 53, 77]},
    {"name": "wheel-toward-later-output-is-button-65", "mode": "press_release", "encoding": "sgr", "kind": "wheel", "wheel_lines": -1.0, "row": 4, "col": 9, "expected": [27, 91, 60, 54, 53, 59, 49, 48, 59, 53, 77]},
    {"name": "wheel-without-movement-sends-nothing", "mode": "press_release", "encoding": "sgr", "kind": "wheel", "wheel_lines": 0.0, "row": 4, "col": 9, "expected": null},
    {"name": "legacy-encoding-offsets-every-value-by-32", "mode": "press_release", "encoding": "default", "kind": "press", "row": 0, "col": 0, "expected": [27, 91, 77, 32, 33, 33]},
    {"name": "utf8-encoding-carries-a-column-past-223", "mode": "press_release", "encoding": "utf8", "kind": "press", "row": 0, "col": 200, "expected": [27, 91, 77, 32, 195, 169, 33]}
  ],
  "scroll_cases_notes": "Arrow keys stand in for the wheel when a full-screen program has not asked for mouse reporting.",
  "scroll_cases": [
    {"name": "two-lines-toward-earlier-output", "lines": 2, "application_cursor": false, "expected": [27, 91, 65, 27, 91, 65]},
    {"name": "one-line-back", "lines": -1, "application_cursor": false, "expected": [27, 91, 66]},
    {"name": "application-cursor-mode-uses-ss3", "lines": 1, "application_cursor": true, "expected": [27, 79, 65]},
    {"name": "application-cursor-mode-back-three", "lines": -3, "application_cursor": true, "expected": [27, 79, 66, 27, 79, 66, 27, 79, 66]},
    {"name": "no-lines-sends-nothing", "lines": 0, "application_cursor": false, "expected": []}
  ],
  "shortcut_cases_notes": "\"secondary\" is the platform's primary modifier: Command on macOS, Control elsewhere. The desktop app reads these; the mobile clients read the key cases.",
  "shortcut_cases": [
    {"name": "palette", "scope": "app", "keystroke": "secondary-k", "expected": "command_palette"},
    {"name": "next-workspace", "scope": "app", "keystroke": "secondary-alt-right", "expected": "cycle_workspace_forward"},
    {"name": "next-workspace-with-tab", "scope": "app", "keystroke": "secondary-alt-tab", "expected": "cycle_workspace_forward"},
    {"name": "previous-workspace", "scope": "app", "keystroke": "secondary-alt-left", "expected": "cycle_workspace_back"},
    {"name": "files", "scope": "app", "keystroke": "secondary-shift-f", "expected": "open_files"},
    {"name": "toggle-files-and-terminal", "scope": "app", "keystroke": "secondary-shift-t", "expected": "toggle_files_and_terminal"},
    {"name": "broadcast", "scope": "app", "keystroke": "secondary-shift-b", "expected": "broadcast_input"},
    {"name": "clear-screen", "scope": "app", "keystroke": "secondary-shift-l", "expected": "clear_screen"},
    {"name": "local-terminal", "scope": "app", "keystroke": "secondary-t", "expected": "local_terminal"},
    {"name": "activity", "scope": "app", "keystroke": "secondary-1", "expected": "navigate_section_1"},
    {"name": "projects", "scope": "app", "keystroke": "secondary-2", "expected": "navigate_section_2"},
    {"name": "hosts", "scope": "app", "keystroke": "secondary-3", "expected": "navigate_section_3"},
    {"name": "sessions", "scope": "app", "keystroke": "secondary-4", "expected": "navigate_section_4"},
    {"name": "files-library", "scope": "app", "keystroke": "secondary-5", "expected": "navigate_section_5"},
    {"name": "devices", "scope": "app", "keystroke": "secondary-6", "expected": "navigate_section_6"},
    {"name": "settings-section", "scope": "app", "keystroke": "secondary-7", "expected": "navigate_section_7"},
    {"name": "settings", "scope": "app", "keystroke": "secondary-,", "expected": "settings"},
    {"name": "logs-or-host-search", "scope": "app", "keystroke": "secondary-l", "expected": "logs_or_host_search"},
    {"name": "new-host-or-session", "scope": "app", "keystroke": "secondary-n", "expected": "new_host_or_session"},
    {"name": "duplicate-pane", "scope": "app", "keystroke": "secondary-d", "expected": "duplicate_pane"},
    {"name": "unmodified-key-is-not-a-shortcut", "scope": "app", "keystroke": "k", "expected": null},
    {"name": "alt-alone-is-not-a-shortcut", "scope": "app", "keystroke": "alt-right", "expected": null},
    {"name": "terminal-copy", "scope": "terminal", "keystroke": "secondary-c", "expected": "copy"},
    {"name": "terminal-paste", "scope": "terminal", "keystroke": "secondary-v", "expected": "paste"},
    {"name": "terminal-search", "scope": "terminal", "keystroke": "secondary-f", "expected": "search"},
    {"name": "terminal-palette", "scope": "terminal", "keystroke": "secondary-k", "expected": "command_palette"},
    {"name": "terminal-close-workspace", "scope": "terminal", "keystroke": "secondary-w", "expected": "close_workspace"},
    {"name": "terminal-focus-chrome", "scope": "terminal", "keystroke": "secondary-shift-escape", "expected": "focus_chrome"},
    {"name": "terminal-typing-is-not-a-shortcut", "scope": "terminal", "keystroke": "c", "expected": null}
  ],
  "drop_cases_notes": "Files dropped on a terminal pane are typed as shell words followed by a space.",
  "drop_cases": [
    {"name": "nothing-dropped", "paths": [], "expected": ""},
    {"name": "plain-path", "paths": ["/Users/me/notes.md"], "expected": "/Users/me/notes.md "},
    {"name": "path-with-a-space", "paths": ["/Users/me/My Files/a.png"], "expected": "'/Users/me/My Files/a.png' "},
    {"name": "path-with-a-quote", "paths": ["/tmp/it's here.txt"], "expected": "'/tmp/it'\\''s here.txt' "},
    {"name": "two-paths", "paths": ["/tmp/a.txt", "/tmp/b c.txt"], "expected": "/tmp/a.txt '/tmp/b c.txt' "},
    {"name": "non-ascii-path-is-quoted", "paths": ["/tmp/résumé.txt"], "expected": "'/tmp/résumé.txt' "}
  ]
